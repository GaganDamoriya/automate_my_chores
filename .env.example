# Copy to .env and fill in. Never commit the real .env.
# Put comments on their own lines only — never after a value.

# Gemini / agents
GEMINI_API_KEY=your-gemini-api-key
# GEMINI_MODEL options: gemini-3.5-flash | gemini-3.7-flash | gemini-2.5-flash
GEMINI_MODEL=gemini-3.5-flash
# USE_ADK=1 runs the real ADK pipeline (needs key + google-adk)
USE_ADK=0
GOOGLE_GENAI_USE_VERTEXAI=FALSE

# Backend
DATABASE_URL=sqlite:///./iwd.sqlite
SEED_DIR=./seed/data
RUN_DB=./runs.sqlite
CORS_ORIGINS=http://localhost:3000
API_HOST=0.0.0.0
API_PORT=8000

# Frontend
NEXT_PUBLIC_API_BASE=http://localhost:8000

# Confirmations (real Slack + Gmail — automations post a 'job done' message).
# Leave blank to keep confirmations simulated (recorded, not actually sent).
SLACK_WEBHOOK_URL=
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
GMAIL_TO=

# ---- OAuth integrations (optional; blank = simulated fallback) --------------
# Register each app with redirect URI:  {OAUTH_REDIRECT_BASE}/auth/<provider>/callback
OAUTH_REDIRECT_BASE=http://localhost:8000
WEB_BASE=http://localhost:3000

# Google (Gmail send + Sheets). Console: APIs & Services > Credentials > OAuth client (Web).
#   Redirect URI: http://localhost:8000/auth/google/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Optional: append run summaries to a real sheet
SHEET_ID=
SHEET_RANGE=Sheet1!A1

# Slack (bot). api.slack.com/apps > OAuth & Permissions > bot scopes chat:write, channels:read.
#   Redirect URI: http://localhost:8000/auth/slack/callback
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
# Channel to post confirmations to when the automation doesn't specify one
SLACK_DEFAULT_CHANNEL=#automations

# GitHub (OAuth app). Settings > Developer settings > OAuth Apps. Scopes: repo, read:user.
#   Redirect URI: http://localhost:8000/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Optional: read real PR reviews from this repo (owner/name)
GITHUB_REPO=

# Jira / Atlassian (3LO). developer.atlassian.com > OAuth 2.0 (3LO). Scopes: read:jira-work, offline_access.
#   Redirect URI: http://localhost:8000/auth/jira/callback
ATLASSIAN_CLIENT_ID=
ATLASSIAN_CLIENT_SECRET=
