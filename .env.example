# Copy to .env and fill in. Never commit the real .env.
# Put comments on their own lines only — never after a value.

# Gemini / agents
GEMINI_API_KEY=your-gemini-api-key
# GEMINI_MODEL options: gemini-3.5-flash | gemini-3.7-flash | gemini-2.5-flash
GEMINI_MODEL=gemini-3.5-flash
# USE_ADK=1 runs the real ADK pipeline (needs key + google-adk)
USE_ADK=0
GOOGLE_GENAI_USE_VERTEXAI=FALSE

# Backend
DATABASE_URL=sqlite:///./iwd.sqlite
SEED_DIR=./seed/data
RUN_DB=./runs.sqlite
CORS_ORIGINS=http://localhost:3000
API_HOST=0.0.0.0
API_PORT=8000

# Frontend
NEXT_PUBLIC_API_BASE=http://localhost:8000
